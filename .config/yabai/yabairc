#!/usr/bin/env sh

# ============================================
# YABAI CONFIG
# ============================================

# --- Scripting Addition (SIP must be disabled) ---
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# --- Layout ---
yabai -m config layout bsp
yabai -m config window_placement second_child

# --- Padding & Gaps ---
yabai -m config top_padding    12
yabai -m config bottom_padding 12
yabai -m config left_padding   12
yabai -m config right_padding  12
yabai -m config window_gap     12

# --- Mouse ---
yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier      fn
yabai -m config mouse_action1       move
yabai -m config mouse_action2       resize
yabai -m mouse_drop_action          swap


# ============================================
# FLOATING APPS
# ============================================

# System
yabai -m rule --add app="^System Settings$"     manage=off
yabai -m rule --add app="^System Preferences$"  manage=off
yabai -m rule --add app="^Software Update$"     manage=off

# Utilities
yabai -m rule --add app="^Calculator$"          manage=off
yabai -m rule --add app="^Archive Utility$"     manage=off
yabai -m rule --add app="^Installer$"           manage=off

# Personal
yabai -m rule --add app="^Karabiner-Elements$"  manage=off
yabai -m rule --add app="^copypasta$"           manage=off
yabai -m rule --add app="^numi$"                manage=off


# ============================================
# DIALOG & POPUP RULES
# ============================================

# By window role (catches most native macOS popups)
yabai -m rule --add role="AXSheet"              manage=off
yabai -m rule --add role="AXDialog"             manage=off
yabai -m rule --add subrole="AXSystemDialog"    manage=off

# By common dialog titles
yabai -m rule --add title="^(General|Preferences|Settings|About|Info)$" manage=off
yabai -m rule --add title="^(Open|Save|Save As|Export|Import|Print)$"  manage=off
yabai -m rule --add title="^(Copy|Move|Progress|Replace|Confirm|Alert)$" manage=off

# Finder (float non-standard folders — catches DMGs)
yabai -m rule --add app="^Finder$" \
    title="^(Copy|Move|Progress|Info|About)$" \
    manage=off

yabai -m rule --add app="^Finder$" \
    title!="^(Downloads|Documents|Desktop|Home|iCloud Drive|Recents|Applications)$" \
    manage=off


# ============================================
# APP-SPECIFIC WORKAROUNDS
# ============================================

# Inkscape — float all windows except main
yabai -m rule --add app="^Inkscape$" \
    title!="^Inkscape$" \
    manage=off

# Blender — float dialogs and file browser
yabai -m rule --add app="^Blender$" \
    title="(File View|Render|Export|Import|Save|Preferences)" \
    manage=off